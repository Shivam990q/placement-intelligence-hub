# ==============================================================================
# 🎓 PLACEMENT INTELLIGENCE HUB — ZERO-COST ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. TELEGRAM BOT KEYS (MANDATORY FOR TELEGRAM AUTOMATION)
# ------------------------------------------------------------------------------
# 1A. Token from @BotFather on Telegram (Format: 123456789:ABCdefGhIJKlmnoPQRstuVWxyz)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# 1B. Your Public or Private Telegram Channel where approved jobs get published
#     (e.g., @Placements or numeric chat ID like -1001234567890)
#     NOTE: Remember to add your bot to this channel as an Administrator with "Post Messages" permission!
TELEGRAM_CHANNEL_ID="@Placements"

# 1C. Your Personal Telegram User ID (or comma-separated IDs of placement coordinators)
#     Get it instantly by sending any message to @userinfobot on Telegram.
#     The bot sends inline approval cards ([Approve] [Reject]) exclusively to these admin IDs!
TELEGRAM_ADMIN_IDS="123456789"

# ------------------------------------------------------------------------------
# 2. TELEGRAM FORUM TOPICS (OPTIONAL — ONLY IF USING SUPERGROUP WITH TOPICS)
# ------------------------------------------------------------------------------
# In a Telegram Supergroup with Topics enabled, right-click any topic -> "Copy Link".
# The last number in the link is the message_thread_id (e.g., https://t.me/c/123456/789 -> ID is 789)
TELEGRAM_FORUM_GROUP_ID=""
TELEGRAM_TOPIC_INTERNSHIPS=
TELEGRAM_TOPIC_FULLTIME=
TELEGRAM_TOPIC_MASSHIRING=
TELEGRAM_TOPIC_GENAI_OPS=
TELEGRAM_TOPIC_RESOURCES=
TELEGRAM_TOPIC_DISCUSSIONS=

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (ZERO SETUP NEEDED BY DEFAULT)
# ------------------------------------------------------------------------------
# Default: High-speed async SQLite (requires ₹0, zero installation, auto-created)
DATABASE_URL="sqlite+aiosqlite:///placement_hub.db"

# Optional: If you want to connect to a local or remote PostgreSQL instance:
# DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/placement_hub"

# ------------------------------------------------------------------------------
# 4. CLOUDFLARE SERVERLESS EDGE & D1 (OPTIONAL — FOR GLOBAL 24/7 EDGE HOSTING)
# ------------------------------------------------------------------------------
# Get your Cloudflare Account ID from your Cloudflare Dashboard URL:
# https://dash.cloudflare.com/<ACCOUNT_ID>
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
EDGE_API_URL="https://placement-hub.<your-subdomain>.workers.dev"
INGEST_SECRET="placement_hub_secret_key_2026"

# ------------------------------------------------------------------------------
# 5. FREE AI EXTRACTION GATEWAY (OPTIONAL — DETERMINISTIC REGEX WORKS 100% OFFLINE)
# ------------------------------------------------------------------------------
# Free Serverless Hugging Face Inference Token from https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=""

# ------------------------------------------------------------------------------
# 6. APP SERVER CONFIGURATION
# ------------------------------------------------------------------------------
APP_NAME="Placement Intelligence Hub"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Watchdog Polling Intervals (in minutes)
ETHARA_CHECK_INTERVAL_MINUTES=15
AMAZON_CHECK_INTERVAL_MINUTES=30
ATS_CHECK_INTERVAL_MINUTES=60
