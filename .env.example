# =======================================================
# Placement Intelligence Hub — Environment Configuration
# =======================================================

# App Configuration
APP_NAME="Placement Intelligence Hub"
DEBUG=true
PORT=8000

# Database Configuration (Default: Zero-setup async SQLite, supports PostgreSQL)
DATABASE_URL="sqlite+aiosqlite:///placement_hub.db"
# For PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://placement_admin:placement_secret_2026@localhost:5432/placement_hub"

# Telegram Bot Configuration
# 1. Obtain token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=""

# 2. Your Telegram Channel username or chat ID (e.g. @Placements or -100xxxxxxxxxx)
TELEGRAM_CHANNEL_ID=""

# 3. Supergroup ID with Forum Topics enabled
TELEGRAM_FORUM_GROUP_ID=""

# 4. Your Telegram User ID for Admin Inline Approval Cards (comma-separated if multiple)
TELEGRAM_ADMIN_IDS="123456789"

# Optional: Specific Forum Topic IDs (message_thread_id)
TELEGRAM_TOPIC_INTERNSHIPS=
TELEGRAM_TOPIC_FULLTIME=
TELEGRAM_TOPIC_MASSHIRING=
TELEGRAM_TOPIC_GENAI_OPS=
TELEGRAM_TOPIC_RESOURCES=
TELEGRAM_TOPIC_DISCUSSIONS=

# Watchdog Intervals (in minutes)
ETHARA_CHECK_INTERVAL_MINUTES=15
AMAZON_CHECK_INTERVAL_MINUTES=30
ATS_CHECK_INTERVAL_MINUTES=60
